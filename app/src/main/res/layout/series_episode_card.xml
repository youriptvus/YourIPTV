<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/series_episode_width" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_focusable" android:padding="4dp"
    android:layout_marginEnd="8dp" android:focusable="true" android:clickable="true">
    <ImageView android:id="@+id/series_episode_art" android:layout_width="match_parent"
        android:layout_height="@dimen/series_episode_image_height" android:scaleType="centerCrop"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/series_episode_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14sp" android:maxLines="2"
        android:ellipsize="end" android:paddingTop="4dp" />
</LinearLayout>
