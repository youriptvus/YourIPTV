<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:id="@+id/section_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="20sp" android:textStyle="bold" android:paddingTop="8dp" android:paddingBottom="4dp" />
    <EditText
        android:id="@+id/search_box" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_input" android:padding="12dp" android:hint="Search channels, movies, series"
        android:textColorHint="@color/text_dim" android:inputType="text" android:imeOptions="actionSearch"
        android:singleLine="true" android:visibility="gone" android:layout_marginBottom="6dp" />
    <TextView
        android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="@color/text_dim" android:paddingBottom="6dp" />
</LinearLayout>
