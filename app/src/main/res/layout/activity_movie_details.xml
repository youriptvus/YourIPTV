<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
    <ImageView android:id="@+id/movie_backdrop" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:alpha="0.15" android:importantForAccessibility="no" />
    <ScrollView android:id="@+id/movie_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <ImageView android:id="@+id/movie_cover" android:layout_width="160dp" android:layout_height="240dp"
                    android:scaleType="fitCenter" android:background="@color/panel" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:paddingStart="20dp">
                    <TextView android:id="@+id/movie_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="28sp" android:textStyle="bold" android:maxLines="3" android:ellipsize="end" />
                    <TextView android:id="@+id/movie_metadata" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textColor="@color/text_dim" android:paddingTop="8dp" android:maxLines="3" />
                    <TextView android:id="@+id/movie_plot" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="16sp" android:paddingTop="14dp" android:maxLines="10" android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:fillViewport="true" android:focusable="false">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/movie_play" style="@style/Button.Tv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Play" />
                    <Button android:id="@+id/movie_beginning" style="@style/Button.Tv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Play from beginning" android:visibility="gone" />
                    <Button android:id="@+id/movie_favorite" style="@style/Button.Tv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Add to favorites" />
                    <Button android:id="@+id/movie_external" style="@style/Button.Tv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Play in external player" />
                </LinearLayout>
            </HorizontalScrollView>
            <TextView android:id="@+id/movie_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="@color/text_dim" android:paddingTop="12dp" />
            <ProgressBar android:id="@+id/movie_progress" android:layout_width="32dp" android:layout_height="32dp" android:visibility="gone" />
            <Button android:id="@+id/movie_retry" style="@style/Button.Tv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Retry details" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
