<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@color/panel" android:gravity="center_vertical">
        <TextView
            android:id="@+id/brand" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="20sp" android:textStyle="bold"
            android:textColor="@color/accent" android:padding="12dp" />
        <TextView
            android:id="@+id/playlist_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/text_dim" android:maxLines="1" android:ellipsize="end" />
        <TextView
            android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="@color/text_dim" android:padding="12dp" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/panel" android:scrollbars="none">
        <LinearLayout android:id="@+id/nav_container" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal" android:padding="4dp" />
    </HorizontalScrollView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/groups" android:layout_width="match_parent" android:layout_height="52dp"
        android:padding="4dp" android:clipToPadding="false" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
        <include layout="@layout/content_header" />
        <LinearLayout
            android:id="@+id/live_header" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingBottom="8dp" android:visibility="gone">
            <include layout="@layout/live_preview" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:paddingStart="8dp">
                <TextView android:id="@+id/live_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/live_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/accent" android:paddingTop="4dp" />
                <TextView android:id="@+id/live_desc" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_dim" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <com.youriptv.app.ui.GuideTimelineView
            android:id="@+id/live_timeline" android:layout_width="match_parent" android:layout_height="30dp"
            android:visibility="gone" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/items" android:layout_width="match_parent" android:layout_height="match_parent"
                android:clipToPadding="false" android:paddingBottom="24dp" />
            <include layout="@layout/content_state" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
