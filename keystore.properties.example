# Release signing configuration. Copy this file to keystore.properties (which is git-ignored)
# and fill in your own values. Never commit keystore.properties or the keystore itself.
#
# storeFile is resolved relative to the app/ module directory; an absolute path also works.
# Keep the keystore outside the repository.
storeFile=../../keys/your-release-key.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME